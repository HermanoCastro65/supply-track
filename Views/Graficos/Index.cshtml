@{
    ViewData["Title"] = "Gráficos";
}

<div class="container-fluid dashboard-container">

    <!-- HEADER -->
    <div class="mb-4">
        <h2 class="fw-bold">Gráficos</h2>
        <p class="text-muted">Visualização de dados e indicadores do sistema</p>
    </div>

    <!-- GRÁFICO ESTOQUE -->
    <div class="card dashboard-card mb-4">
        <div class="card-body">
            <h5 class="fw-semibold mb-3">Estoque por Mercadoria</h5>
            <canvas id="graficoEstoque" height="100"></canvas>
        </div>
    </div>

    <!-- GRÁFICO MOVIMENTAÇÕES -->
    <div class="card dashboard-card">
        <div class="card-body">
            <h5 class="fw-semibold mb-3">Entradas x Saídas por Mês e Mercadoria</h5>
            <canvas id="graficoMes" height="100"></canvas>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const estoque = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Estoque));
    const porMes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PorMes));

    // ===== GRÁFICO ESTOQUE =====
    const nomes = estoque.map(x => x.nome);
    const quantidades = estoque.map(x => x.quantidade);

    new Chart(document.getElementById('graficoEstoque'), {
    type: 'bar',
    data: {
    labels: nomes,
    datasets: [{
    label: 'Quantidade em Estoque',
    data: quantidades,
    backgroundColor: '#3b82f6',
    borderRadius: 6
    }]
    },
    options: {
    responsive: true,
    plugins: {
    legend: { display: false }
    },
    scales: {
    y: {
    beginAtZero: true,
    grid: {
    color: '#e5e7eb'
    }
    },
    x: {
    grid: {
    display: false
    }
    }
    }
    }
    });

    // ===== ORGANIZA DADOS POR MERCADORIA =====
    const agrupado = {};

    porMes.forEach(item => {
    const key = item.mercadoria + " - " + item.mes;

    if (!agrupado[key]) {
    agrupado[key] = {
    label: key,
    entradas: item.entradas,
    saidas: item.saidas
    };
    }
    });

    const labels = Object.keys(agrupado);
    const entradas = labels.map(l => agrupado[l].entradas);
    const saidas = labels.map(l => agrupado[l].saidas);

    new Chart(document.getElementById('graficoMes'), {
    type: 'bar',
    data: {
    labels: labels,
    datasets: [
    {
    label: 'Entradas',
    data: entradas,
    backgroundColor: '#22c55e',
    borderRadius: 6
    },
    {
    label: 'Saídas',
    data: saidas,
    backgroundColor: '#ef4444',
    borderRadius: 6
    }
    ]
    },
    options: {
    responsive: true,
    plugins: {
    legend: {
    position: 'top'
    }
    },
    scales: {
    y: {
    beginAtZero: true,
    grid: {
    color: '#e5e7eb'
    }
    },
    x: {
    grid: {
    display: false
    }
    }
    }
    }
    });
</script>