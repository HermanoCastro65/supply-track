@model IEnumerable<SupplyTrack.Models.Movimentacao>

@{
    ViewData["Title"] = "Gráficos";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">Movimentações por Tipo</h2>

    <canvas id="grafico"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const dados = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    const entradas = dados.filter(x => x.Tipo === "Entrada").length;
    const saidas = dados.filter(x => x.Tipo === "Saída").length;

    const ctx = document.getElementById('grafico');

    new Chart(ctx, {
    type: 'pie',
    data: {
    labels: ['Entradas', 'Saídas'],
    datasets: [{
    data: [entradas, saidas]
    }]
    }
    });
</script>