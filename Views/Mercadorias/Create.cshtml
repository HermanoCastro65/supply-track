@model SupplyTrack.Models.Mercadoria

@{
    ViewData["Title"] = "Nova Mercadoria";
}

<div class="container-fluid dashboard-container">

    <div class="mb-4">
        <h2 class="fw-bold">Nova Mercadoria</h2>
        <p class="text-muted">Preencha os dados para cadastrar um novo item</p>
    </div>

    <div class="card dashboard-card">
        <div class="card-body">

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NumeroRegistro" class="form-label"></label>
                        <input asp-for="NumeroRegistro" class="form-control" />
                        <span asp-validation-for="NumeroRegistro" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Fabricante" class="form-label"></label>
                        <input asp-for="Fabricante" class="form-control" />
                        <span asp-validation-for="Fabricante" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Tipo" class="form-label"></label>
                        <input asp-for="Tipo" class="form-control" />
                        <span asp-validation-for="Tipo" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descricao" class="form-label"></label>
                        <input asp-for="Descricao" class="form-control" />
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Salvar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}