@model SupplyTrack.Models.Mercadoria

@{
    ViewData["Title"] = "Excluir";
}

<div class="container-fluid dashboard-container">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">Excluir Mercadoria</h2>
        <p class="text-muted">Confirme a exclusão do item</p>
    </div>

    <div class="card dashboard-card">
        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Nome</dd>

                <dt class="col-sm-3">Registro</dt>
                <dd class="col-sm-9">@Model.NumeroRegistro</dd>

                <dt class="col-sm-3">Fabricante</dt>
                <dd class="col-sm-9">@Model.Fabricante</dd>

                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@Model.Tipo</dd>

                <dt class="col-sm-3">Descrição</dt>
                <dd class="col-sm-9">@Model.Descricao</dd>

            </dl>

        </div>
    </div>

    <form asp-action="Delete" class="mt-4 d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>

</div>