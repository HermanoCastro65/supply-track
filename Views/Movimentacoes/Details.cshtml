@model SupplyTrack.Models.Movimentacao

@{
    ViewData["Title"] = "Detalhes";
}

<div class="container-fluid dashboard-container">

    <div class="mb-4">
        <h2 class="fw-bold">Detalhes da Movimentação</h2>
    </div>

    <div class="card dashboard-card">
        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">Mercadoria</dt>
                <dd class="col-sm-9">@Model.Mercadoria?.Nome</dd>

                <dt class="col-sm-3">Quantidade</dt>
                <dd class="col-sm-9">@Model.Quantidade</dd>

                <dt class="col-sm-3">Data</dt>
                <dd class="col-sm-9">@Model.DataHora</dd>

                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@Model.Tipo</dd>

                <dt class="col-sm-3">Observação</dt>
                <dd class="col-sm-9">@Model.Observacao</dd>

            </dl>

        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>

</div>